# Everything here is optional and free.

# Optional free AI via Ollama (https://ollama.com), running on your own computer.
# Leave OLLAMA_MODEL empty to use keyword matching only.
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434

# Your location for weather alerts
LOCATION_NAME=Tel Aviv
LOCATION_LAT=32.0853
LOCATION_LON=34.7818
TZ_NAME=Asia/Jerusalem

PORT=3000
REFRESH_MINUTES=15
